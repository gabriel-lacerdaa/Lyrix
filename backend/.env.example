# Copie para .env e preencha.

# PostgreSQL. Também usadas pelo docker-compose.yml. As tabelas são criadas com schemas.sql:
#   psql -h localhost -p 5432 -U lyrix -d lyrix -f schemas.sql
POSTGRES_HOST=localhost
POSTGRES_DB=lyrix
POSTGRES_USER=lyrix
POSTGRES_PASSWORD=lyrix
POSTGRES_PORT=5432

# Google Cloud > YouTube Data API v3 > credencial "Chave de API".
YOUTUBE_API_KEY=

# Vazio = rotas /admin sem senha (uso só no localhost). Preenchido = exige o cabeçalho X-Admin-Token.
ADMIN_TOKEN=

REGION_CODE=BR

# Tradução sob demanda (POST /translate): portal Azure > recurso "Translator" > Chaves e Ponto de Extremidade.
# Vazio = a rota responde 503. A região é a do recurso (ex.: brazilsouth); deixe vazia se ele for "global".
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Lista em JSON.
CORS_ORIGINS=["http://localhost:5173"]

# Alinhamento automático (worker).
WHISPER_MODEL=base
DEMUCS_MODEL=htdemucs
TEMP_DIR=./tmp
