# Copie para .env.local e ajuste.

# Endereço da API (backend/). No celular, use o IP da máquina na rede local
# e rode a API com: uvicorn api.main:app --reload --host 0.0.0.0
# Emulador Android: http://10.0.2.2:8000 · Simulador iOS: http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
EXPO_TOKEN=token_expo_para_acessar_pelo_ios