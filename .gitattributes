# Fins de linha LF no repositório (evita diferenças CRLF/LF entre Windows, macOS e Linux).
* text=auto eol=lf

# Scripts do Windows mantêm CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários: sem conversão.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
